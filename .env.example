LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=
LLM_API_KEY=not-needed-for-ollama
# Hosted instead of local, e.g. OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-...
#   LLM_MODEL=qwen/qwen3-32b
# Optional: sent as reasoning_effort when set ("none" turns off thinking on qwen3)
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=300
LLM_RETRY_BACKOFF_SECONDS=5
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app
MLFLOW_TRACKING_URI=http://mlflow:5000
DATA_DIR=./data
MAX_UPLOAD_MB=1024
REVIEW_CONFIDENCE_THRESHOLD=0.8
AGENT_MAX_STEPS=25
BUILD_MAX_REPAIRS=3
TOOL_QUERY_TIMEOUT_SECONDS=60
TOOL_MEMORY_LIMIT=2GB
